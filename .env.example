GS1_COMPANY_PREFIX=

# GS1 Kenya OAuth SSO. Register this exact callback URL with GS1 Kenya.
GS1_SSO_CLIENT_ID=
GS1_SSO_CLIENT_SECRET=
GS1_SSO_CALLBACK_URL=https://your-domain.example/auth/gs1/callback

# GS1 Kenya member API. Sandbox base URL includes /activate.
# Used to mint SSCCs and to read the serials packed in a case.
GS1_MEMBER_API_BASE_URL=
GS1_MEMBER_API_TOKEN=

# PPB National Track & Trace Hub (docs/PPB_TNT_INTEGRATION.md)
# Facility-tier credential (used for events with participant_tier=facility,
# and as the fallback for distributor if PPB_TNT_DISTRIBUTOR_* is unset).
PPB_TNT_BASE_URL=
PPB_TNT_CAPTURE_PATH=/epcis/v2/capture
PPB_TNT_API_KEY=
PPB_TNT_ENABLED=false

# Distributor-tier credential (used for events with participant_tier=distributor)
PPB_TNT_DISTRIBUTOR_CAPTURE_PATH=
PPB_TNT_DISTRIBUTOR_API_KEY=
