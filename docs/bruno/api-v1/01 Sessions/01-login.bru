meta {
  name: Login
  type: http
  seq: 1
}

post {
  url: {{base_url}}/api/v1/login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{email}}",
    "password": "{{password}}"
  }
}

script:post-response {
  bru.setEnvVar("access_token", res.body.access_token);
}

docs {
  Signs in staff (email + password). Stores the access token for the other requests.
}
