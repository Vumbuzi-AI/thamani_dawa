meta {
  name: Create a product
  type: http
  seq: 3
}

post {
  url: {{base_url}}/api/v1/manufacturer/products
  body: json
  auth: bearer
}

headers {
  Idempotency-Key: {{$guid}}
}

auth:bearer {
  token: {{access_token}}
}

body:json {
  {
    "gtin": "06164000000016",
    "name": "Amoxicillin 500mg",
    "description": "Capsules, 20s",
    "brand_owner": "Uzski Pharma",
    "brand_owner_address": "Nairobi",
    "licence_type": "pharmaceutical"
  }
}

docs {
  The licence key is never returned.
}
