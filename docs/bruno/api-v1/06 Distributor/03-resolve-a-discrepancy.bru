meta {
  name: Resolve a discrepancy
  type: http
  seq: 3
}

post {
  url: {{base_url}}/api/v1/distributor/discrepancies/{{discrepancy_id}}/resolve
  body: json
  auth: bearer
}

headers {
  Idempotency-Key: {{$guid}}
}

auth:bearer {
  token: {{access_token}}
}

body:json {
  {
    "status": "lost",
    "resolution_reference": "INV-2026-014"
  }
}

docs {
  `found`, `lost` or `stolen`. Lost and stolen need `resolution_reference` and fire the EPCIS event.
}
