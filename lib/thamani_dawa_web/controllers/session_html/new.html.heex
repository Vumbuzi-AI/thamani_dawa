<div class="td-auth">
  <div class="td-auth-corner">
    <.td_button variant="secondary" label="Create an account" navigate={~p"/signup"} />
  </div>

  <div class="td-auth-col">
    <a href="/" aria-label="Thamani Dawa home" class="td-auth-logo">
      <img src="/images/logo-transparent.png" alt="Thamani Dawa" />
    </a>

    <Layouts.flash_group flash={@flash} />

    <.td_auth_card title="Log in">
      <details :if={@demo_accounts != []} id="demo-login-accounts" class="td-auth-demo">
        <summary>Explore the demo</summary>
        <div class="td-auth-roles">
          <.form
            :for={account <- @demo_accounts}
            for={account.form}
            id={"demo-login-#{account.id}"}
            action={~p"/login"}
            method="post"
          >
            <.input field={account.form[:email]} type="hidden" />
            <.input field={account.form[:password]} type="hidden" />
            <.td_button
              id={"demo-login-#{account.id}-submit"}
              type="submit"
              variant="secondary"
              label={account.role}
            />
          </.form>
        </div>
      </details>

      <.form for={@form} id="login-form" action={~p"/login"} method="post" class="td-auth-form">
        <.td_input
          field={@form[:email]}
          type="email"
          label="Email address"
          placeholder="you@yourpharmacy.com"
          autocomplete="email"
          required
        />
        <.td_input
          field={@form[:password]}
          type="password"
          label="Password"
          placeholder="••••••••"
          autocomplete="current-password"
          required
        />
        <.td_button id="login-submit" type="submit" variant="primary" size="lg" label="Log in" />
      </.form>
      <:footer>
        <.link navigate={~p"/reset-password"}>Forgot your password?</.link>
      </:footer>
    </.td_auth_card>
  </div>
</div>
