<section
  style="background: #FFFFFF; min-height: calc(100vh - 64px);"
  class="flex items-center justify-center py-24 px-6 sm:px-10"
>
  <div class="contact-shell w-full">
    <h1
      class="mb-6 text-center"
      style="font-size: clamp(32px, 4vw, 42px); font-weight: 350; letter-spacing: -0.72px; color: #1c3a13;"
    >
      Contact Us
    </h1>
    <p class="text-center mb-10" style="font-size: 18px; color: #666666;">
      Have a question or need support? We'd love to hear from you.
    </p>

    <aside class="contact-proof" aria-label="Support details">
      <span>Built around your operation</span>
      <h2>Let’s make every branch easier to run.</h2>
      <p>
        Tell us what is slowing your team down. We’ll map the right path across dispensing,
        inventory, laboratories and compliance.
      </p>
      <dl>
        <div>
          <dt>01</dt><dd>Share your workflow</dd>
        </div>
        <div>
          <dt>02</dt><dd>See a tailored walkthrough</dd>
        </div>
        <div>
          <dt>03</dt><dd>Plan a calm rollout</dd>
        </div>
      </dl>
    </aside>
    <div class="contact-form-card">
      <.form for={@form} class="space-y-4">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <.thamani_input field={@form[:name]} label="Full Name" placeholder="Jane Doe" required />
          <.thamani_input
            field={@form[:email]}
            type="email"
            label="Email Address"
            placeholder="jane@example.com"
            required
          />
        </div>
        <.thamani_input
          field={@form[:message]}
          type="textarea"
          label="Message"
          rows="5"
          placeholder="How can we help?"
          required
        />
        <.thamani_btn variant="primary" type="submit" class="w-full mt-4">
          Send Message
        </.thamani_btn>
      </.form>
    </div>
  </div>
</section>

<.page_footer active_link={:contact} />
