<a class="skip-link" href="#main">Skip to content</a>
<header class="site-header">
  <div class="nav-shell">
    <a class="brand" href="/" aria-label="Thamani Dawa home"><img
      src="/images/logo-transparent.png"
      alt=""
      width="56"
      height="56"
    /></a>
    <nav class="desktop-nav" aria-label="Primary navigation">
      <a href="#features">Features</a><a href="#results">Why Thamani</a><a href="/contact">Contact</a>
    </nav>
    <div class="desktop-actions">
      <%= if @current_scope do %>
        <a
          class="rounded-full aspect-square"
          href={dashboard_path(@current_scope)}
          aria-label="Open dashboard"
        >
          {String.at(@current_scope.user.name || "U", 0)}
        </a>
        <a class="button button-small button-dark" href={dashboard_path(@current_scope)}>Dashboard</a>
      <% else %>
        <a class="button button-small button-light login-cta" href="/login">Log in</a><a
          class="button button-small button-dark"
          href="/signup"
        >Get started</a>
      <% end %>
    </div>
    <button
      class="menu-button"
      type="button"
      aria-label="Open menu"
      aria-controls="mobile-menu"
      aria-expanded="false"
    ><span></span><span></span><span></span></button>
  </div>
</header>
<dialog class="mobile-menu" id="mobile-menu" aria-label="Site menu">
  <div class="menu-top">
    <a class="brand" href="/" aria-label="Thamani Dawa home"><img
      src="/images/logo-transparent.png"
      alt=""
      width="56"
      height="56"
    /></a><button class="menu-close" type="button" aria-label="Close menu"><span></span><span></span></button>
  </div>
  <div class="menu-groups">
    <div>
      <p>Product</p><a href="#features">Features</a><a href="/login">Log in</a><a href="/signup">Create account</a>
    </div><div>
      <p>Company</p><a href="#results">Why Thamani</a><a href="/contact">Contact</a>
    </div><div>
      <p>Legal</p><a href="/privacy">Privacy policy</a><a href="/terms">Terms of service</a>
    </div>
  </div>
</dialog>
<main id="main">
  <section class="hero-section">
    <div class="container hero-grid">
      <div class="hero-copy reveal">
        <h1>Run pharmacy operations with clarity.</h1><p class="hero-intro">
          One secure platform for dispensing, inventory, labs, controlled medicines and every branch.
        </p><div class="hero-actions">
          <a class="button button-dark" href="/signup">Get started</a><a
            class="button button-light"
            href="/contact"
          >Book a walkthrough</a>
        </div><p class="hero-note">GS1 ready. Designed for pharmacy teams in Kenya.</p><dl class="hero-metrics">
          <div>
            <dt>
              <span class="metric-value" data-target="500" data-suffix="+" aria-label="500 plus">0</span>
            </dt><dd>Products catalogued</dd>
          </div><div>
            <dt>
              <span class="metric-value" data-target="50" data-suffix="+" aria-label="50 plus">0</span>
            </dt><dd>Active sites</dd>
          </div><div>
            <dt>
              <span
                class="metric-value"
                data-target="100"
                data-suffix="%"
                aria-label="100 percent"
              >0</span>
            </dt><dd>GS1 compliant</dd>
          </div>
        </dl>
      </div>
      <div class="hero-visual">
        <div class="hero-image-wrap">
          <img
            src="/images/thamanidawa-heroo.webp"
            alt="Pharmacist using Thamani Dawa to manage medicines"
          />
        </div><div class="hero-dashboard">
          <div><small>Live network</small><strong>4 branches connected</strong></div><div
            class="network-pulse"
            aria-hidden="true"
          >
            <i></i><i></i><i></i><i></i><i></i><i></i>
          </div><span>All synced</span>
        </div><p class="image-caption">Connected care begins with a clear record.</p>
      </div>
    </div>
  </section>
  <section class="network-section" aria-labelledby="network-title">
    <div class="container network-layout reveal">
      <h2 id="network-title">Trusted across Kenya’s care network.</h2><div
        class="network-types"
        aria-label="Teams using Thamani Dawa"
      >
        <span>Pharmacies</span><span>Medical centres</span><span>Laboratories</span><span>Multi-site groups</span>
      </div>
    </div>
  </section>
  <section class="standards-section">
    <div class="container standards-layout reveal">
      <div class="standards-copy">
        <h2>One calm system for the work that cannot afford confusion.</h2><div
          class="medicine-journey"
          aria-label="Medicine traceability journey"
        >
          <span>Manufacturer</span><span>Receiving</span><span>Branch</span><span>Dispensing</span><span>Patient</span>
        </div>
      </div><div class="standards-list">
        <div><strong>GS1</strong><span>Traceable by design</span></div><div>
          <strong>Every branch</strong><span>One shared view</span>
        </div><div><strong>Every role</strong><span>Access with purpose</span></div><div>
          <strong>Every action</strong><span>A complete record</span>
        </div>
      </div>
    </div>
  </section>
  <section class="section" id="platform">
    <div class="container">
      <div class="platform-title reveal">
        <h2>Less switching.<br />More certainty.</h2><p>
          Give every team one reliable source of truth, from receiving to the final dispense.
        </p>
      </div>
      <div class="product-showcase reveal">
        <div class="workflow-switcher" role="tablist" aria-label="Pharmacy workflows">
          <button
            class="is-active"
            type="button"
            role="tab"
            id="tab-dispense"
            aria-selected="true"
            aria-controls="panel-dispense"
            data-workflow="dispense"
          ><span>01</span>Dispense</button><button
            type="button"
            role="tab"
            id="tab-inventory"
            aria-selected="false"
            aria-controls="panel-inventory"
            data-workflow="inventory"
          ><span>02</span>Inventory</button><button
            type="button"
            role="tab"
            id="tab-compliance"
            aria-selected="false"
            aria-controls="panel-compliance"
            data-workflow="compliance"
          ><span>03</span>Compliance</button>
        </div>
        <div class="showcase-grid">
          <div class="showcase-canvas">
            <img src="/images/dawas.png" alt="Medicine bottles arranged inside a modern pharmacy" /><div class="product-window">
              <div class="window-bar">
                <span></span><span></span><span></span><strong>Thamani Dawa / Branch 01</strong>
              </div><div
                class="interface-panel is-active"
                id="panel-dispense"
                role="tabpanel"
                aria-labelledby="tab-dispense"
                data-panel="dispense"
              >
                <small>Product scanned</small><h3>Amoxicillin 500 mg</h3><p>Batch KE2408</p><strong class="status-positive">Verified for dispense</strong>
              </div><div
                class="interface-panel"
                id="panel-inventory"
                role="tabpanel"
                aria-labelledby="tab-inventory"
                data-panel="inventory"
                hidden=""
              >
                <small>Live inventory</small><div class="inventory-numbers">
                  <div><strong>1,284</strong><span>Available</span></div><div>
                    <strong>04</strong><span>Branches</span>
                  </div>
                </div><p class="stock-signal"><i></i>Stock synchronized now</p>
              </div><div
                class="interface-panel"
                id="panel-compliance"
                role="tabpanel"
                aria-labelledby="tab-compliance"
                data-panel="compliance"
                hidden=""
              >
                <small>Register status</small><h3>All records complete</h3><p>
                  Last verified two minutes ago
                </p><div class="audit-progress"><i></i></div><strong class="status-positive">Audit ready</strong>
              </div>
            </div>
          </div>
          <div class="workflow-narrative">
            <article class="is-active" data-copy="dispense">
              <span>01 / Dispense</span><h3>Confidence at the counter.</h3><p>
                Confirm the correct product and preserve a clear chain of custody without slowing the team.
              </p>
            </article><article data-copy="inventory" hidden="">
              <span>02 / Inventory</span><h3>Stock answers in real time.</h3><p>
                Track quantities, batches and expiry dates across every location in one shared view.
              </p>
            </article><article data-copy="compliance" hidden="">
              <span>03 / Compliance</span><h3>Always ready for review.</h3><p>
                Maintain permission-based records that are complete before an audit begins.
              </p>
            </article>
          </div>
        </div>
      </div>
    </div>
  </section>
  <section class="section dark-section" id="features">
    <div class="container">
      <div class="feature-intro reveal">
        <h2>Every workflow<br />has a clear home.</h2><p>
          Six connected tools replace the scattered systems that slow pharmacy teams down.
        </p>
      </div><div class="feature-list">
        <article tabindex="0">
          <span class="feature-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 4h6v6H4zM14 4h6v6h-6zM4 14h6v6H4zM15 14h1v1h-1zM19 14h1v3h-1zM14 18h3v2h-3zM19 19h1v1h-1z">
          </path></svg></span><h3>GS1 dispensing</h3><p>
            Scan products at the counter and keep every batch linked to the correct patient transaction.
          </p><span class="workflow-signal">Batch verified</span>
        </article><article tabindex="0">
          <span class="feature-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M9 3h6M10 3v5l-5 9a3 3 0 0 0 2.6 4h8.8A3 3 0 0 0 19 17l-5-9V3M8 14h8">
          </path></svg></span><h3>Inventory control</h3><p>
            Monitor live stock, expiry risk, receiving and transfers from one consistent view.
          </p><span class="workflow-signal">Stock synchronized</span>
        </article><article tabindex="0">
          <span class="feature-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M8 3h8M10 3v6l-5 8a3 3 0 0 0 2.6 4h8.8A3 3 0 0 0 19 17l-5-8V3M8 15h8M9 18h.01M13 17h.01">
          </path></svg></span><h3>Laboratory workflows</h3><p>
            Order tests, follow samples and deliver results without losing the thread between teams.
          </p><span class="workflow-signal">Sample traceable</span>
        </article><article tabindex="0">
          <span class="feature-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 3 5 6v5c0 4.6 2.9 8.4 7 10 4.1-1.6 7-5.4 7-10V6zM9 12l2 2 4-4">
          </path></svg></span><h3>Controlled medicines</h3><p>
            Use permission based dispensing and automatic logs to protect patients and staff.
          </p><span class="workflow-signal">Register complete</span>
        </article><article tabindex="0">
          <span class="feature-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 21V8l8-5 8 5v13M8 21v-5h8v5M8 10h.01M12 10h.01M16 10h.01">
          </path></svg></span><h3>Multi branch oversight</h3><p>
            Compare performance, people and stock across locations without separate spreadsheets.
          </p><span class="workflow-signal">Branches aligned</span>
        </article><article tabindex="0">
          <span class="feature-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M6 3h9l3 3v15H6zM14 3v4h4M9 11h6M9 15h6M9 19h4">
          </path></svg></span><h3>Prescription history</h3><p>
            Keep a reliable patient record from prescription review through final dispensing.
          </p><span class="workflow-signal">History preserved</span>
        </article>
      </div>
    </div>
  </section>
  <section class="section results-section" id="results">
    <div class="container results-shell reveal">
      <div class="results-copy">
        <h2>See the full picture before the next decision.</h2><button
          class="result-item is-active"
          type="button"
          data-result="patients"
          aria-pressed="true"
        ><span>01</span><div>
          <h3>Protect patients</h3><p>
            Give pharmacists the right safety and stock context at the point of care.
          </p>
        </div></button><button
          class="result-item"
          type="button"
          data-result="drag"
          aria-pressed="false"
        ><span>02</span><div>
          <h3>Reduce drag</h3><p>
            Replace repeated entry and disconnected branch reports with one workflow.
          </p>
        </div></button><button
          class="result-item"
          type="button"
          data-result="risk"
          aria-pressed="false"
        ><span>03</span><div>
          <h3>Spot risk</h3><p>
            See low stock, expiring products and unusual movement before they become problems.
          </p>
        </div></button>
      </div><div class="results-visual">
        <img src="/images/site.webp" alt="Modern pharmacy operations workspace" /><div
          class="result-overlay is-active"
          data-result-panel="patients"
        >
          <small>Patient safety</small><strong>Interaction check complete</strong><span>Prescription and stock context aligned</span>
        </div><div class="result-overlay" data-result-panel="drag" hidden="">
          <small>Branch workflow</small><strong>One shared record</strong><span>Receiving, transfers and dispensing connected</span>
        </div><div class="result-overlay" data-result-panel="risk" hidden="">
          <small>Risk signal</small><strong>Expiry attention required</strong><span>Flagged before the next dispense</span>
        </div><span class="orbit-dot" aria-hidden="true"></span>
      </div>
    </div>
  </section>
  <section class="testimonial-section" id="customers">
    <div class="container testimonial-layout reveal">
      <h2>Built for the pressure behind the counter.</h2><figure>
        <blockquote>
          “I’m excited to be working with a platform that does more than count pills. It has given us real intelligence about our stock, our compliance, and our patients.”
        </blockquote><figcaption>
          <strong>Dr. Amina Kariuki</strong><span>Head of Pharmacy, Nairobi General Medical Centre</span>
        </figcaption>
      </figure>
    </div>
  </section>
  <section class="cta-section">
    <div class="container cta-shell reveal">
      <h2>Bring your pharmacy network into focus.</h2><p>
        Start with one branch. See the difference across all of them.
      </p><div class="cta-actions">
        <a class="button button-lime" href="/signup">Create your account</a><a
          class="button button-ghost"
          href="/contact"
        >Talk to the team</a>
      </div>
    </div>
  </section>
</main>
<footer class="site-footer">
  <div class="container footer-lead">
    <a class="footer-logo" href="/" aria-label="Thamani Dawa home"><img
      src="/images/logo-transparent.png"
      alt=""
      width="156"
      height="112"
    /></a><p>Pharmacy operations, finally in one place.</p>
  </div><div class="container footer-grid">
    <div>
      <p class="footer-label">Product</p><a href="#platform">Platform</a><a href="#features">Features</a><a href="/login">Log in</a><a href="/signup">Create account</a>
    </div><div>
      <p class="footer-label">Company</p><a href="#results">Why Thamani</a><a href="/contact">Contact</a>
    </div><div>
      <p class="footer-label">Legal</p><a href="/privacy">Privacy policy</a><a href="/terms">Terms of service</a>
    </div>
  </div><div class="container footer-bottom">
    <p>© 2026 Thamani Dawa</p><p>Healthcare software for Kenya</p>
  </div>
</footer>
