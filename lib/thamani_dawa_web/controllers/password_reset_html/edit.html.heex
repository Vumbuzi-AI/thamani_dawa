<div class="td-auth">
  <div class="td-auth-corner">
    <.td_button variant="secondary" label="Back to log in" navigate={~p"/login"} />
  </div>

  <div class="td-auth-col">
    <a href="/" aria-label="Thamani Dawa home" class="td-auth-logo">
      <img src="/images/logo-transparent.png" alt="Thamani Dawa" />
    </a>

    <Layouts.flash_group flash={@flash} />

    <.td_auth_card
      title="Choose a new password"
      subtitle="Make it something you haven't used before."
    >
      <.form
        for={@form}
        id="password-reset-form"
        action={~p"/reset-password/#{@token}"}
        method="post"
        class="td-auth-form"
      >
        <.td_input
          field={@form[:password]}
          type="password"
          label="New password"
          placeholder="••••••••"
          autocomplete="new-password"
          required
        />
        <.td_button type="submit" variant="primary" size="lg" label="Reset password" />
      </.form>
    </.td_auth_card>
  </div>
</div>
