<div class="td-auth">
  <div class="td-auth-corner">
    <.td_button variant="secondary" label="Back to log in" navigate={~p"/login"} />
  </div>

  <div class="td-auth-col">
    <a href="/" aria-label="Thamani Dawa home" class="td-auth-logo">
      <img src="/images/logo-transparent.png" alt="Thamani Dawa" />
    </a>

    <Layouts.flash_group flash={@flash} />

    <.td_auth_card
      title="Reset your password"
      subtitle="Enter your email and we'll send a one-time reset link."
    >
      <.form
        for={@form}
        id="password-reset-request-form"
        action={~p"/reset-password"}
        method="post"
        class="td-auth-form"
      >
        <.td_input
          field={@form[:email]}
          type="email"
          label="Email address"
          placeholder="you@yourpharmacy.com"
          autocomplete="email"
          required
        />
        <.td_button type="submit" variant="primary" size="lg" label="Send reset link" />
      </.form>
    </.td_auth_card>
  </div>
</div>
