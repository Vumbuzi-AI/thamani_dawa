<div class="mx-auto mt-24 max-w-md px-6">
  <Layouts.flash_group flash={@flash} />
  <h1 class="text-2xl font-semibold text-thamani-forest">Reset password</h1>
  <p class="mt-2 text-sm text-thamani-pewter">
    Enter your email and we will send a one-time reset link.
  </p>
  <.form
    for={@form}
    id="password-reset-request-form"
    action={~p"/reset-password"}
    method="post"
    class="mt-6 space-y-4"
  >
    <.input field={@form[:email]} type="email" label="Email" autocomplete="email" required />
    <.button type="submit" variant="primary">Send reset link</.button>
  </.form>
</div>
