<div class="td-auth">
  <div class="td-auth-corner">
    <.td_button variant="secondary" label="Back to log in" navigate={~p"/login"} glyph="arrow-left" />
  </div>

  <div class="td-auth-col">
    <a href="/" aria-label="Thamani Dawa home" class="td-auth-logo">
      <img src="/images/logo-transparent.png" alt="Thamani Dawa" />
    </a>

    <div class="td-auth-panel">
      <h1>Reset your password</h1>
      <p class="td-auth-lead">
        Enter the email you log in with. We will send you a link to choose a new password.
      </p>
      <p :if={msg = Phoenix.Flash.get(@flash, :error)} class="td-auth-error">{msg}</p>

      <.form
        for={@form}
        id="password-reset-request-form"
        action={~p"/reset-password"}
        method="post"
        class="td-auth-form"
      >
        <.td_input
          field={@form[:email]}
          type="email"
          label="Email address"
          placeholder="you@yourpharmacy.com"
          autocomplete="email"
          required
        />
        <.td_button type="submit" variant="primary" size="lg" label="Send reset link" />
      </.form>

      <p class="td-auth-switch">
        <span>Remembered it?</span>
        <.link navigate={~p"/login"}>Back to log in</.link>
      </p>
    </div>
  </div>

  <div class="td-auth-page-foot">
    <.link navigate={~p"/privacy"}>Privacy</.link>
    <.link navigate={~p"/terms"}>Terms</.link>
  </div>
</div>
