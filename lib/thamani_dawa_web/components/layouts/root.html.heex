<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <meta
      name="google-maps-api-key"
      content={Application.get_env(:thamani_dawa, :google_maps)[:api_key]}
    />
    <.live_title default="Thamani Dawa · Pharmacy, Lab & Distribution" suffix="" phx-no-format>{if assigns[:page_title], do: "#{assigns[:page_title]} · Thamani Dawa"}</.live_title>
    <link rel="icon" type="image/png" href={~p"/favicon.png"} />
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <%!-- Product UI: Inter 400/500 and JetBrains Mono 400/500 (Doop --font-sans, --font-mono).
         Rethink Sans is only for the public landing page (Doop --font-landing). --%>
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500&family=JetBrains+Mono:wght@400;500&family=Rethink+Sans:wght@400..600&display=swap"
      rel="stylesheet"
    />
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.9/dist/chart.umd.min.js">
    </script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js">
    </script>
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
    <%!-- Body font and background are set in app.css (Inter for the app and auth,
         Rethink Sans for the landing pages only). --%>
    <script>
      // One theme switch for the whole app. The preference is "system", "light"
      // or "dark", stored in localStorage under "phx:theme" ("system" = no key).
      // <html data-theme> always holds the resolved "light" or "dark", set here
      // before first paint so there is no flash.
      (() => {
        const KEY = "phx:theme";
        const PREFS = ["system", "light", "dark"];
        const root = document.documentElement;
        const media = matchMedia("(prefers-color-scheme: dark)");
        const systemTheme = () => (media.matches ? "dark" : "light");

        const readPref = () => {
          let pref = null;
          try { pref = localStorage.getItem(KEY); } catch (_e) {}
          if (PREFS.includes(pref)) return pref;
          // Drop anything else, e.g. the literal "toggle" an older switch stored.
          if (pref !== null) { try { localStorage.removeItem(KEY); } catch (_e) {} }
          return "system";
        };

        const syncControls = () => {
          const pref = root.getAttribute("data-theme-pref") || "system";
          const dark = root.getAttribute("data-theme") === "dark";
          document.querySelectorAll("[data-theme-switch]").forEach((el) => {
            el.setAttribute("aria-checked", String(dark));
            el.classList.toggle("is-on", dark);
          });
          document.querySelectorAll("[data-phx-theme]:not([data-theme-switch])").forEach((el) => {
            const on = String(el.dataset.phxTheme === pref);
            el.setAttribute(el.getAttribute("role") === "menuitemradio" ? "aria-checked" : "aria-pressed", on);
          });
        };

        const apply = (pref) => {
          const theme = pref === "system" ? systemTheme() : pref;
          root.setAttribute("data-theme", theme);
          root.setAttribute("data-theme-pref", pref);
          root.setAttribute("data-theme-source", pref === "system" ? "system" : "user");
          syncControls();
        };

        const setTheme = (requested) => {
          let pref = requested;
          // The sidebar switch asks to flip whatever is showing now.
          if (pref === "toggle") pref = root.getAttribute("data-theme") === "dark" ? "light" : "dark";
          if (!PREFS.includes(pref)) return;
          try {
            if (pref === "system") localStorage.removeItem(KEY);
            else localStorage.setItem(KEY, pref);
          } catch (_e) {}
          apply(pref);
        };

        apply(readPref());

        window.addEventListener("phx:set-theme", (e) => setTheme(e.target.dataset.phxTheme));
        window.addEventListener("storage", (e) => e.key === KEY && apply(readPref()));
        media.addEventListener("change", () => readPref() === "system" && apply("system"));
        // Re-sync controls after LiveView renders or navigates.
        document.addEventListener("DOMContentLoaded", syncControls);
        window.addEventListener("phx:page-loading-stop", syncControls);
      })();
    </script>
  </head>
  <body>
    {@inner_content}
  </body>
</html>
